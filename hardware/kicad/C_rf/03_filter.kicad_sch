		(uuid "010f2c4b-58de-4617-849e-5cd9ba108a0a")
	)
	(text "Uc rezonatorlu, tepeden kapasitif kuplajli Chebyshev 0.1 dB.\nRezonator reaktansi 200 ohm hedeflendi (once kapasiteyi sabit\ntutmustum, 160m'de 68 uH cikmisti — o degerde RF bobini yok).\n\nbant      f0     BW     L      Crez  Ckup  Cuc   IL\n160m     1.89   0.30   16uH   430p   62p  270p  3.5/0.5 dB\n80/60m   4.32   2.10   7.5uH  180p   82p  390p  0.96\n40/30m   8.43   3.40   3.9uH   91p   33p  160p  0.86\n20/17m  15.95   4.40   2.0uH   51p   13p   56p  1.01\n15/10m  24.96   8.90   1.3uH   30p   10p   47p  0.71\n6m      51.94   5.00   620nH   15p  1.3p  5.6p  2.4/1.2 dB"
		(exclude_from_sim no)
		(at 640 240 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "23498d30-41ca-4254-9cec-69d40deae905")
	)
