				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "5c21ea96-01aa-46df-9e40-56e02a647f09")
	)
	(text "BANT FILTRESI BANKASI — 7 pozisyon x 4 kanal"
		(exclude_from_sim no)
		(at 16 14 0)
