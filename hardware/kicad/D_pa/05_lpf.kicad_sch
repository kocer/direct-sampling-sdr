	(text "Zincir giris/cikisi. 0R yerine dogrudan tel de olurdu ama\nyerlesimde olcum noktasi olarak ise yariyor."
		(exclude_from_sim no)
		(at 620 80 0)
		(effects
			(font
				(size 1.3 1.3)
			)
