	(text "SO-239 kasaya, karta kisa koaksiyel. 100 W'ta SMA da tasir\nama amator istasyonun kablo tarafi PL-259; donusturucu\neklemek her baglantida bir kayip ve bir arizali temas noktasi\ndaha demek.\n\nTerminal 1.5 sqmm lehim teli icin: 100 W / 50 ohm = 1.4 A,\nama SWR 3:1'de tepe akim iki katina cikiyor."
		(exclude_from_sim no)
		(at 16 445 0)
		(effects
			(font
				(size 1.35 1.35)
			)
			(justify left top)
		)
		(uuid "0a6559c7-ad7e-4c27-9f50-5b86a2ecab71")
	)
	(text "DETEKTORLER — AD8318 x2"
		(exclude_from_sim no)
		(at 300 95 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "1b644d89-eed8-4c16-b3a7-f50874776851")
	)
	(text "ANTEN CIKISI"
		(exclude_from_sim no)
		(at 16 395 0)
		(effects
