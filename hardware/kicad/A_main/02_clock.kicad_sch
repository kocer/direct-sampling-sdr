	(text "Dort ADC kanali ve iki DAC ayni saatten besleniyor. Gurultu iptali,\nyon bulma ve isin sekillendirme bu dagitimin simetrisine bagli."
		(exclude_from_sim no)
		(at 16 20 0)
		(effects
			(font
				(size 1.35 1.35)
			)
			(justify left top)
		)
		(uuid "078ad13b-e2d1-4777-8e73-956230e86bbd")
	)
	(text "ADC SAATLERI — LVDS, DOGRUDAN"
		(exclude_from_sim no)
		(at 300 200 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "092fd0e3-a8f7-4ecf-9bce-887aa0937234")
	)
	(text "ADCLK846 — 1:6 LVDS"
		(exclude_from_sim no)
		(at 300 40 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
