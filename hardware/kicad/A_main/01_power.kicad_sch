	)
	(text "U8 (+2V5) ECP5 VCCAUX. Ilk guc agacinda ATLANMISTI — FPGA'yi hic\ncalistirmayan turden bir eksik. ADP150AUJZ-2.5, LCSC C144257."
		(exclude_from_sim no)
		(at 105 244 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "44295d82-fc2b-4ddd-8ded-f87c63df2e70")
	)
	(text "AYRISTIRMA (NETLIST.md §1)\nher ECP5 VCC/VCCIO topu 100nF, viasi dogrudan duzleme · ECP5 toplu 4x10uF + 2x47uF\nADC AVDD x8 pin basina 100nF + toplu 10uF · ADC DRVDD x4 100nF\nVCXO 100nF + 10uF + FERRIT BONCUK · PHY 10uF X5R  (Y5V KULLANMA, datasheet s.46-53)"
		(exclude_from_sim no)
		(at 20 250 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "50cfbbda-c952-4d7d-861e-e55d6c89201e")
	)
	(text "GUC BUTCESI ~2.8 W -> 12V'ta ~230 mA. 10 Ah aku ile ~40 saat.\nSaha modunda ikinci PHY yazilimdan kapatilabilir, 0.25 W kazanc."
		(exclude_from_sim no)
		(at 20 268 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "66f5de42-60f2-4003-a17c-2a9c61532d08")
	)
	(text "DAC AVDD\nFERRIT, LDO DEGIL"
		(exclude_from_sim no)
		(at 312 226 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "7227ed05-73ff-4a05-8eeb-87a56cb21342")
	)
	(text "VCXO zinciri\nFERRIT, LDO DEGIL"
		(exclude_from_sim no)
		(at 257 226 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "73797114-54e1-47b5-be99-cc45ad9966d7")
	)
	(text "Vout = 0.8 x (1 + R3/R4).  3.3V icin oran 3.125\nL1, Cin ve Cout datasheet Tablo 8'den."
		(exclude_from_sim no)
		(at 37 159 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "77c4b8f2-3be7-4ec0-8f08-78ecdb0896ec")
	)
	(text "ANA RAY +3V3 — TPS62130, 3-17V giris, 3A"
		(exclude_from_sim no)
		(at 20 100 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "98ca430a-8bf2-4592-998c-fa9d7cd3340f")
	)
	(text "HASSAS RAYLAR — her biri AYRI LDO, AYRI ADA. Anahtarlamalidan BESLENMEZ (§1)."
		(exclude_from_sim no)
		(at 20 185 0)
		(effects
