	)
	(text "U8 (+2V5) ECP5 VCCAUX. Ilk guc agacinda ATLANMISTI — FPGA'yi hic\ncalistirmayan turden bir eksik. ADP150AUJZ-2.5, LCSC C144257."
		(exclude_from_sim no)
		(at 105 244 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
