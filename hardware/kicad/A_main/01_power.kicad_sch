	)
	(text "1.1V icin oran 0.375.  EN zinciri: U1 PG -> U2 EN,\nguc siralamasi VCC(1.1) once, sonra VCCAUX, sonra VCCIO."
		(exclude_from_sim no)
		(at 237 159 0)
