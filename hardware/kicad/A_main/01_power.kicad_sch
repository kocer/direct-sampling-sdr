	(text "FPGA VCCAUX\nZORUNLU"
		(exclude_from_sim no)
		(at 92 226 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "1428e551-e4e3-41c0-9350-cddeebf61ab9")
	)
	(text "AYRISTIRMA (NETLIST.md §1)\nher ECP5 VCC/VCCIO topu 100nF, viasi dogrudan duzleme · ECP5 toplu 4x10uF + 2x47uF\nADC AVDD x8 pin basina 100nF + toplu 10uF · ADC DRVDD x4 100nF\nVCXO 100nF + 10uF + FERRIT BONCUK · PHY 10uF X5R  (Y5V KULLANMA, datasheet s.46-53)"
		(exclude_from_sim no)
		(at 20 250 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "1b779ce3-839f-4a54-8b53-74e796385010")
	)
	(text "ADCLK846 VS\nZORUNLU 1.8V"
		(exclude_from_sim no)
		(at 367 226 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "1ed08c59-6ec9-4f94-831c-2d782189057f")
	)
	(text "1.1V icin oran 0.375.  EN zinciri: U1 PG -> U2 EN,\nguc siralamasi VCC(1.1) once, sonra VCCAUX, sonra VCCIO."
		(exclude_from_sim no)
		(at 237 159 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "3de791f4-a648-4db9-b0b0-180477db328d")
	)
	(text "Vout = 0.8 x (1 + R3/R4).  3.3V icin oran 3.125\nL1, Cin ve Cout datasheet Tablo 8'den."
		(exclude_from_sim no)
		(at 37 159 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "452da1e2-ed20-4a23-9db4-13a651868b25")
	)
	(text "U6 (+3V3_CLK) VCXO'nun TEK beslemesi. Ferrit boncuk, ayri toprak adasi.\nBesleme gurultusu DOGRUDAN faz gurultusune donusuyor — manset spec burada."
		(exclude_from_sim no)
		(at 105 232 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "4c0f5581-ab9f-4f67-868f-2657c85f0acd")
	)
	(text "DAC AVDD"
		(exclude_from_sim no)
		(at 312 226 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "4dcb2df1-24ee-4ca1-b479-85ecb837c9b8")
	)
	(text "VCXO — TEK\nbesleme, FERRIT"
		(exclude_from_sim no)
		(at 257 226 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "60ee79da-ad70-4000-b90b-88b74fd341e0")
	)
	(text "FPGA CEKIRDEK +1V1 — TPS62130 #2"
		(exclude_from_sim no)
		(at 220 100 0)
		(effects
			(font
